From 89d2842264b3a1e4b6d0d6427609a18c7fbfaedb Mon Sep 17 00:00:00 2001
From: "Claude (Implementer)" <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 08:21:09 +0000
Subject: [PATCH 2/3] test(parser): editor behaviour of parse_kle (RK65 pair,
 Ergodox thumb cluster, small layouts, errors)

---
 tests/test_kle_parser.py | 195 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 195 insertions(+)
 create mode 100644 tests/test_kle_parser.py

diff --git a/tests/test_kle_parser.py b/tests/test_kle_parser.py
new file mode 100644
index 0000000..793fc7d
--- /dev/null
+++ b/tests/test_kle_parser.py
@@ -0,0 +1,195 @@
+"""parse_kle() follows the Keyboard Layout Editor (WP-13).  No CAD, fast.
+
+The editor is the reference: ``rx`` / ``ry`` set the position, properties apply
+to the next key only, decals are no keys, ``r`` / ``rx`` / ``ry`` belong at the
+start of a row.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+import fat_plate_generator as fpg
+from tests.conftest import REPO_ROOT
+
+KLE_DIR = REPO_ROOT / "kle-jsons"
+RK65 = KLE_DIR / "keyboard-layout_065-percent-iso_royal-kludge-rk65.json"
+RK65_CLEAN = KLE_DIR / "keyboard-layout_065-percent-iso_royal-kludge-rk65_clean.json"
+ERGODOX = KLE_DIR / "ergodox_split_ergo_67-keys.json"
+SHAPE = ("x", "y", "w", "h", "x2", "y2", "w2", "h2")
+
+
+def parse(text):
+    return fpg.parse_kle(json.loads(text))
+
+
+def parse_file(path):
+    return fpg.parse_kle(json.loads(path.read_text(encoding="utf-8")))
+
+
+def placed(keys):
+    """(label, x, y) of every key."""
+    return [(k["label"], k["x"], k["y"]) for k in keys]
+
+
+def assert_placed(keys, expected):
+    assert [k["label"] for k in keys] == [label for label, _, _ in expected]
+    for key, (label, x, y) in zip(keys, expected):
+        assert (key["x"], key["y"]) == pytest.approx((x, y)), label
+
+
+# --------------------------------------------------------------------------
+# Layouts of the repository
+# --------------------------------------------------------------------------
+def test_rk65_export_and_clean_file_have_the_same_key_positions():
+    """The export puts Del in a row of its own behind ``rx``; the hand-cleaned
+    file has the same keyboard.  The labels differ on purpose."""
+    exported, clean = parse_file(RK65), parse_file(RK65_CLEAN)
+    assert len(exported) == len(clean)
+    shapes = lambda keys: sorted(tuple(k[name] for name in SHAPE) for k in keys)
+    assert shapes(exported) == shapes(clean)
+
+
+def test_rk65_del_is_where_the_editor_shows_it():
+    for path in (RK65, RK65_CLEAN):
+        delete = [k for k in parse_file(path) if k["label"] == "Del"]
+        assert len(delete) == 1, path.name
+        assert (delete[0]["x"], delete[0]["y"]) == pytest.approx((15, 1)), path.name
+
+
+def test_ergodox_thumb_cluster_keeps_the_ry_of_its_cluster():
+    """Row 23 is ``{"r": -30, "rx": 13, "y": -1, "x": -3}``: ``rx`` without
+    ``ry``, so ``y`` restarts at the ``ry`` of the row before (4.25)."""
+    keys = [k for k in parse_file(ERGODOX) if k["rx"] == 13]
+    assert len(keys) >= 2
+    assert all(k["r"] == -30 and k["ry"] == 4.25 for k in keys)
+    assert (keys[0]["x"], keys[0]["y"]) == pytest.approx((10, 3.25))
+    assert (keys[1]["x"], keys[1]["y"]) == pytest.approx((11, 3.25))
+
+
+# --------------------------------------------------------------------------
+# rx / ry set the position
+# --------------------------------------------------------------------------
+@pytest.mark.parametrize("text, expected", [
+    # rx sets x and y (to the ry set last, here 0), then x / y are added
+    ('[["A"], [{"rx": 2, "y": 1, "x": 1}, "B"]]', [("A", 0, 0), ("B", 3, 1)]),
+    # the ry set last is kept when only rx is given
+    ('[[{"r": 30, "rx": 1, "ry": 2}, "A"], [{"rx": 4}, "B"]]', [("A", 1, 2), ("B", 4, 2)]),
+    # ry alone: x goes back to the rx set last (0)
+    ('[["A"], [{"ry": 5}, "B"]]', [("A", 0, 0), ("B", 0, 5)]),
+    ('[[{"rx": 3}, "A"], ["B"]]', [("A", 3, 0), ("B", 3, 1)]),         # every row starts at rx
+    ('[[{"rx": 3, "ry": 2}, "A", "B"], ["C"]]', [("A", 3, 2), ("B", 4, 2), ("C", 3, 3)]),
+    # r alone does not move anything
+    ('[["A"], [{"r": 15}, "B"]]', [("A", 0, 0), ("B", 0, 1)]),
+    ('[["A", "B"], [{"r": 15, "x": 2}, "C"]]', [("A", 0, 0), ("B", 1, 0), ("C", 2, 1)]),
+])
+def test_rx_and_ry_set_the_position(text, expected):
+    assert_placed(parse(text), expected)
+
+
+def test_keys_carry_the_rotation_origin_they_were_created_with():
+    keys = parse('[[{"r": 10, "rx": 1, "ry": 2}, "A"], [{"rx": 5}, "B"], [{"r": 0}, "C"]]')
+    assert [(k["r"], k["rx"], k["ry"]) for k in keys] == [(10, 1, 2), (10, 5, 2), (0, 5, 2)]
+
+
+def test_a_layout_without_rotation_is_not_moved_by_the_fix():
+    keys = parse('[["A", {"x": 1}, "B"], [{"y": 0.5, "x": 0.25}, "C"], ["D"]]')
+    assert_placed(keys, [("A", 0, 0), ("B", 2, 0), ("C", 0.25, 1.5), ("D", 0, 2.5)])
+    assert all((k["r"], k["rx"], k["ry"]) == (0, 0, 0) for k in keys)
+
+
+# --------------------------------------------------------------------------
+# properties apply to the next key
+# --------------------------------------------------------------------------
+def test_two_objects_before_a_key_add_up():
+    keys = parse('[[{"w": 2}, {"c": "#fff"}, "A", "B"]]')
+    assert [k["w"] for k in keys] == [2, 1]
+    assert [k["w2"] for k in keys] == [2, 1]
+    assert_placed(keys, [("A", 0, 0), ("B", 2, 0)])
+
+
+def test_properties_of_two_objects_are_combined():
+    key, = parse('[[{"w": 2}, {"h": 3}, "A"]]')
+    assert (key["w"], key["h"], key["w2"], key["h2"]) == (2, 3, 2, 3)
+
+
+def test_properties_are_reset_after_the_key():
+    first, second = parse('[[{"w": 2, "h": 2, "l": true, "x2": 0.5, "y2": 0.25}, "A", "B"]]')
+    assert (first["w"], first["h"], first["w2"], first["h2"], first["l"]) == (2, 2, 2, 2, True)
+    assert (first["x2"], first["y2"]) == (0.5, 0.25)
+    assert (second["w"], second["h"], second["w2"], second["h2"]) == (1, 1, 1, 1)
+    assert (second["x2"], second["y2"], second["l"]) == (0, 0, False)
+
+
+def test_w_sets_w2_and_h_sets_h2_unless_they_are_given():
+    assert [(k["w2"], k["h2"]) for k in parse('[[{"w": 2, "h": 3}, "A"]]')] == [(2, 3)]
+    assert [(k["w2"], k["h2"]) for k in parse('[[{"w": 2, "w2": 3, "h": 4, "h2": 1}, "A"]]')] == [(3, 1)]
+    # within one object w comes first, so a w2 in an earlier object is overwritten by a later w
+    assert parse('[[{"w2": 3}, {"w": 2}, "A"]]')[0]["w2"] == 2
+    assert parse('[[{"w": 2}, {"w2": 3}, "A"]]')[0]["w2"] == 3
+
+
+def test_the_rotation_stays_until_it_is_changed():
+    keys = parse('[[{"r": 20, "rx": 1, "ry": 1}, "A"], ["B"], [{"r": 0}, "C"]]')
+    assert [k["r"] for k in keys] == [20, 20, 0]
+
+
+def test_iso_enter_is_unchanged():
+    key, = parse('[[{"x": 0.25, "w": 1.25, "h": 2, "w2": 1.5, "h2": 1, "x2": -0.25}, "Enter"]]')
+    assert key == {"label": "Enter", "w": 1.25, "h": 2, "x2": -0.25, "y2": 0.0, "w2": 1.5, "h2": 1,
+                   "l": False, "r": 0.0, "rx": 0.0, "ry": 0.0, "x": 0.25, "y": 0.0}
+
+
+def test_stepped_caps_lock_is_unchanged():
+    key, = parse('[[{"w": 1.25, "w2": 1.75, "l": true}, "Caps Lock"]]')
+    assert (key["w"], key["w2"], key["h"], key["h2"], key["l"]) == (1.25, 1.75, 1, 1, True)
+
+
+def test_a_key_has_exactly_the_fields_it_had_before():
+    key, = parse('[["A"]]')
+    assert set(key) == {"label", "x", "y", "w", "h", "x2", "y2", "w2", "h2", "l", "r", "rx", "ry"}
+
+
+# --------------------------------------------------------------------------
+# decals
+# --------------------------------------------------------------------------
+@pytest.mark.parametrize("text, expected", [
+    ('[[{"d": true, "w": 2}, "deco", "Q"]]', [("Q", 2, 0)]),
+    ('[["Q", {"d": true}, "x", "W"]]', [("Q", 0, 0), ("W", 2, 0)]),
+    ('[[{"d": false}, "Q"]]', [("Q", 0, 0)]),
+    ('[[{"d": true, "w": 3}, "deco"], ["Q"]]', [("Q", 0, 1)]),          # the decal's row still counts
+])
+def test_decals_are_no_keys_but_take_their_space(text, expected):
+    assert_placed(parse(text), expected)
+
+
+def test_a_decal_uses_up_its_properties():
+    keys = parse('[[{"d": true, "w": 2, "h": 2, "l": true}, "deco", "Q"]]')
+    assert len(keys) == 1
+    assert (keys[0]["w"], keys[0]["h"], keys[0]["l"]) == (1, 1, False)
+
+
+# --------------------------------------------------------------------------
+# r, rx and ry only at the start of a row
+# --------------------------------------------------------------------------
+@pytest.mark.parametrize("name", ["r", "rx", "ry"])
+def test_rotation_options_after_the_first_item_are_an_error(name):
+    with pytest.raises(ValueError, match=r"can only be used on the first key of a row") as error:
+        parse('[["Q"], ["A", {"%s": 10}, "B"]]' % name)
+    assert "row at index 1" in str(error.value) and repr(name) in str(error.value)
+
+
+def test_a_second_object_at_the_start_of_a_row_is_too_late():
+    with pytest.raises(ValueError, match=r"first key of a row.*row at index 0"):
+        parse('[[{"x": 1}, {"ry": 2}, "A"]]')
+
+
+def test_the_first_item_of_a_row_may_be_a_rotation_object():
+    keys = parse('[["Q"], [{"r": 10, "rx": 1, "ry": 2, "x": 1}, "A", "B"]]')
+    assert_placed(keys, [("Q", 0, 0), ("A", 2, 2), ("B", 3, 2)])
+
+
+def test_other_options_may_stand_anywhere_in_a_row():
+    keys = parse('[["A", {"x": 1, "y": 0.5, "w": 2, "c": "#fff"}, "B", {"d": false}, "C"]]')
+    assert_placed(keys, [("A", 0, 0), ("B", 2, 0.5), ("C", 4, 0.5)])
-- 
2.43.0


From 66ddc08870380cf76ba95935d671387a43455c92 Mon Sep 17 00:00:00 2001
From: "Claude (Implementer)" <noreply@anthropic.com>
Date: Mon, 9 Nov 2026 08:21:09 +0000
Subject: [PATCH 3/3] docs: WP-13 parser behaviour in README, CHANGELOG and
 ROADMAP

---
 CHANGELOG.md | 4 ++++
 README.md    | 2 ++
 ROADMAP.md   | 5 +++--
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 13c0fac..19faa16 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -31,6 +31,9 @@ All notable changes to this project are documented in this file.
 
 ### Changed
 
+- `parse_kle()` reads the properties of a key like the Keyboard Layout Editor: `w`, `h`, `x2`, `y2`, `w2`, `h2` and `l` apply to the next key and are reset only after a key, so several objects in a row before one key add up (`{"w": 2}, {"c": "#fff"}, "A"` gives A the width 2); `w` also sets `w2` and `h` also sets `h2` unless the same object names them. Single objects before a key give the same result as before (ISO Enter, stepped Caps Lock).
+- Decals (`"d": true`) are ignored: they get no footprint and no cutout, but the position moves on by their width. No layout in `kle-jsons/` has decals.
+- `r`, `rx` and `ry` anywhere but on the first item of a row are an error (`ValueError` naming the row) instead of being read silently wrong. KLE exports do not produce this.
 - The right off-centered spacebar is the left template mirrored instead of a second file. The mirror is an exact integer matrix in the template's own coordinates, applied before the stabilizer rotation (so it matches the former right file for every rotation); it is the only cutout that is mirrored, and `PlateModel.mirrored` records it per key. The plate is unchanged apart from float noise in the templates (`centered` and `off-centered-left` byte-identical). `TemplateSet` has one field `spacebar_off_centered` (the left file) instead of two, and `TemplateSet.spacebar_for()` is the single place that maps a position to a file and a mirror flag. `stabilzer_spacebar_off-center_right.stl` stays in the repository but is no longer read.
 - `--spacebar-off-centered` and the config key `templates.spacebar_off_centered` replace `--spacebar-off-centered-left` / `--spacebar-off-centered-right` and `spacebar_off_centered_left` / `spacebar_off_centered_right`. The old names are not kept as aliases and are refused as unknown.
 - `generate()` and `build_plate_model()` take a `Settings` object (with a `TemplateSet` for the template paths) instead of long parameter lists: `build_plate_model(kle_path, settings)` and `generate(kle_path, settings, output, config_path=None)`. The generated STL is byte-identical to before (checked for the orientation test layout, the 40% layout and the stepped Caps Lock with `--stepped-key wide-caps`).
@@ -63,6 +66,7 @@ All notable changes to this project are documented in this file.
 
 ### Fixed
 
+- Keys after `rx` / `ry` lie where the Keyboard Layout Editor shows them. The editor sets the position to `(rx, ry)` when either is given (the one that is not given keeps its last value); `parse_kle()` set only `x` for `rx` and only `y` for `ry`. Examples: Del in `keyboard-layout_065-percent-iso_royal-kludge-rk65.json` was at (15, 6) instead of (15, 1) and now matches the hand-cleaned `…_rk65_clean.json`; the thumb cluster of `ergodox_split_ergo_67-keys.json` (row 23 with `rx` but no `ry`, 6 keys) moved up by 2 u. All other layouts in `kle-jsons/` parse exactly as before.
 - KLE `name` and `author` metadata at the beginning of Raw Data is now ignored instead of being parsed as extra keys.
 - Corrected the default KLE layout path and the default wide-caps template lookup; aligned path-dependent tests and added guards for exact repository path casing and default stepped-key generation.
 - Spacebar (and every other) stabilizer cutout was mirrored horizontally by the whole-plate transform; a left spacebar template came out as a right one.
diff --git a/README.md b/README.md
index d9edafe..54d36b4 100644
--- a/README.md
+++ b/README.md
@@ -247,6 +247,8 @@ python .\fat_plate_generator.py --json my_keyboard.json --output my_keyboard.stl
 
 Important: Use the KLE **Raw Data JSON**, not another JSON export format. A `name` and `author` metadata object at the beginning of the Raw Data is allowed and ignored. Other JSON formats are rejected.
 
+The parser follows the Keyboard Layout Editor, so the plate has the keys where the editor shows them: `rx` or `ry` set the position of the next key (the one that is not given keeps its last value), a decal (`"d": true`) is only a legend and not a key (it takes its space, but gets no cutout), and `r`, `rx` and `ry` are only allowed on the first item of a row (anywhere else the generator stops with an error that names the row).
+
 ---
 
 # 9. Using Custom STL Files
diff --git a/ROADMAP.md b/ROADMAP.md
index 25b067f..4dd829f 100644
--- a/ROADMAP.md
+++ b/ROADMAP.md
@@ -6,7 +6,7 @@ Stand: `main` @ `7631001` (WP-07 bis WP-12 gemerged, 338 Tests grün laut WP-12-
 
 ## Reihenfolge
 
-~~WP-07~~ → ~~WP-08~~ → ~~WP-09~~ → ~~WP-10~~ → ~~WP-11~~ → ~~WP-12~~ → WP-13 → WP-14. WP-15 ist noch nicht beauftragt und hat niedrige Priorität.
+~~WP-07~~ → ~~WP-08~~ → ~~WP-09~~ → ~~WP-10~~ → ~~WP-11~~ → ~~WP-12~~ → ~~WP-13~~ → WP-14. WP-15 ist noch nicht beauftragt und hat niedrige Priorität.
 
 ## Arbeitspakete
 
@@ -49,11 +49,12 @@ Stand: `main` @ `7631001` (WP-07 bis WP-12 gemerged, 338 Tests grün laut WP-12-
   - Mit `--single-mesh` wirkungslos (Hinweis in der Ausgabe). Neuer Config-Schlüssel `fuse_f_row`, CLI `--fuse-f-row/--no-fuse-f-row`.
   - Ohne die Option byte-identisch zu vorher.
   - Umgesetzt: `top_row_keys()` (unrotierte Tasten mit dem kleinsten KLE-`y`) und `plate_footprint(..., fuse_top_row=False)`; `Settings.fuse_f_row`, CLI `--fuse-f-row/--no-fuse-f-row`, Config-Schlüssel `fuse_f_row`. Nachgemessen: Plattenteile vorher → nachher G80-3000 und ISO-105 9 → 5, TKL 8 → 4, JD40 unverändert (1); die STLs für `stabilizer_orientation`, `jd40` und `stepped-capslock` (wide-caps) sind ohne Option byte-identisch zu `392162d`; `--fuse-f-row --single-mesh` ergibt dieselbe Platte wie `--single-mesh` allein. 338 Tests grün.
-- [ ] **WP-13** KLE-Parser wie der Editor (Bugfix, Priorität 1)
+- [x] **WP-13** KLE-Parser wie der Editor (Bugfix, Priorität 1)
   - Auslöser: `kle-jsons/keyboard-layout_065-percent-iso_royal-kludge-rk65.json` (vom Editor exportiert): Del liegt bei (15, 6) statt (15, 1); `…_rk65_clean.json` ist das richtige Ergebnis.
   - Ursache: Im Editor setzt `rx` **oder** `ry` die aktuelle Position auf `(rx, ry)` (der nicht genannte Wert bleibt auf dem zuletzt gesetzten). `parse_kle()` setzt bei `rx` nur `x` und bei `ry` nur `y`. Gleiches Problem im Ergodox-Layout (Reihe 23: `rx` ohne `ry`, 5 Tasten falsch). Alle anderen Layouts in `kle-jsons/` ändern sich nicht (mit Prototyp verglichen).
   - Mit dabei, weil dieselbe Funktion: Eigenschaften (`w`, `h`, `x2`, …) gelten bis zur nächsten Taste (mehrere Objekte vor einer Taste), Decals (`"d": true`) sind keine Tasten, `r`/`rx`/`ry` nur am Reihenanfang (sonst Fehler wie im Editor)
   - Tests: RK65-Paar (fehlerhaft = bereinigt), Ergodox-Position, Tabelle kleiner Layouts, Fehlerfall; einmaliger Nachweis, dass alle übrigen Layouts unverändert parsen
+  - Umgesetzt: `parse_kle()` setzt bei `rx`/`ry` die Position auf `(rx, ry)`, Eigenschaften gelten bis zur nächsten Taste, Decals werden übersprungen (ihre Breite zählt), `r`/`rx`/`ry` nur am Reihenanfang. Nachgemessen: alle 20 Layouts in `kle-jsons/` und `tests/layouts/` vor/nach verglichen; geändert sind nur RK65 (Del, 1 Taste) und Ergodox (6 Tasten, nicht 5: Reihe 23 bis 25 hängen alle an `rx = 13`); RK65 und `…_rk65_clean.json` ergeben byte-identische STLs; die STLs für `stabilizer_orientation`, `jd40` und `stepped-capslock` (wide-caps) sind byte-identisch zu vorher. 370 Tests grün.
