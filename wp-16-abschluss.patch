From 06823be8af88a6433c7d10a8eba09df8fe14ac27 Mon Sep 17 00:00:00 2001
From: "Claude (Implementer)" <noreply@anthropic.com>
Date: Thu, 12 Nov 2026 12:48:14 +0000
Subject: [PATCH 1/3] test(widths): the unsupported-width message must list 3u
 as supported

---
 tests/test_template_widths.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/tests/test_template_widths.py b/tests/test_template_widths.py
index e4bcbe4..96fe7c9 100644
--- a/tests/test_template_widths.py
+++ b/tests/test_template_widths.py
@@ -57,9 +57,10 @@ def test_unsupported_width_is_rejected_when_selecting_template(width):
         fpg.template_kind_for_key(k, fpg.classify_key(k), 2.0)
 
 
-def test_unsupported_width_error_mentions_3u():
-    k = key("example", w=3.25)
-    with pytest.raises(ValueError, match=r"3u"):
+@pytest.mark.parametrize("width", [3.25, 4.0])
+def test_unsupported_width_error_lists_3u_as_supported(width):
+    k = key("example", w=width)
+    with pytest.raises(ValueError, match=r"supported widths are .*\b3u\b"):
         fpg.template_kind_for_key(k, fpg.classify_key(k), 2.0)
 
 
-- 
2.43.0


